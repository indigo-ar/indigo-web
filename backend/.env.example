# Copiá este archivo como .env (dev) o .env.production (prod)

NODE_ENV=development

# MercadoPago
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx

# Frontend URL
FRONTEND_URL=https://tu-sitio.com

# Admin panel
ADMIN_PASSWORD=tu-password-seguro

# Supabase (dev → indigo-dev, prod → indigo-prod)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# WhatsApp del admin (con código de país, sin +)
ADMIN_WHATSAPP=5491100000000
